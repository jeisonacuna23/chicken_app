<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/acento"
            android:text="Cierre de jornada"/>

        <TextView
            android:id="@+id/tvCierreFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:textColor="@color/textoSuave"/>

        <TextView
            android:id="@+id/tvCierrePollos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/texto"/>

        <TextView
            android:id="@+id/tvCierrePeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="16sp"
            android:textColor="@color/texto"/>

        <TextView
            android:id="@+id/tvCierreTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/texto"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Revisa los recibos antes de cerrar. Al cerrar, se guarda el resumen en TXT y se borran todos los datos."
            android:textColor="@color/textoSuave"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnVerRecibos"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Ver recibos de la jornada"/>

        <Button
            android:id="@+id/btnCerrarBorrar"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Cerrar y borrar"/>

        <Button
            android:id="@+id/btnCancelarCierre"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar"/>
    </LinearLayout>
</ScrollView>
