<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pollos K"
            android:textSize="32sp"
            android:textColor="@color/acento"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="32dp"/>

        <Button
            android:id="@+id/btnInventario"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Inventario"/>

        <Button
            android:id="@+id/btnVender"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Registrar venta"/>

        <Button
            android:id="@+id/btnHistorial"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Historial"/>

        <Button
            android:id="@+id/btnDeudas"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Deudas"/>

        <Button
            android:id="@+id/btnPagados"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Pagados"/>

        <Button
            android:id="@+id/btnResumen"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Resumen"/>
    </LinearLayout>
</ScrollView>
