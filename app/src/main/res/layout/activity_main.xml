<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivMainLogo"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="24dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_app"/>

        <Button
            android:id="@+id/btnInventario"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:drawableStart="@drawable/ic_inventario"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="16dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Inventario"/>

        <Button
            android:id="@+id/btnVender"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_vender"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="16dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Registrar venta"/>

        <Button
            android:id="@+id/btnHistorial"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_historial"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="16dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Historial"/>

        <Button
            android:id="@+id/btnDeudas"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_deudas"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="16dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Deudas"/>

        <Button
            android:id="@+id/btnPagados"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_pagados"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="16dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Pagados"/>

        <Button
            android:id="@+id/btnResumen"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_resumen"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="16dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Resumen"/>
    </LinearLayout>
</ScrollView>
