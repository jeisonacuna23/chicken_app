<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:padding="8dp">

    <EditText
        android:id="@+id/etBuscarPagados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar por cliente..."
        android:inputType="textPersonName"
        android:padding="12dp"
        android:textColor="@color/texto"
        android:textColorHint="@color/textoSuave"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvPagadosVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="No hay ventas pagadas."
        android:textColor="@color/textoSuave"
        android:gravity="center"
        android:visibility="gone"/>

    <ListView
        android:id="@+id/lvPagados"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
