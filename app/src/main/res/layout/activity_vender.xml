<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del cliente"
            android:textColor="@color/texto"
            android:textColorHint="@color/textoSuave"
            android:inputType="textPersonName"/>

        <EditText
            android:id="@+id/etPrecioKg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Precio por kilo (ej. 10000)"
            android:textColor="@color/texto"
            android:textColorHint="@color/textoSuave"
            android:inputType="numberDecimal"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pollos a vender"
            android:textStyle="bold"
            android:textColor="@color/acento"/>

        <LinearLayout
            android:id="@+id/llPollos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvSinPollos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="No hay pollos disponibles. Agrega pollos en Inventario."
            android:textColor="#C62828"
            android:visibility="gone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Metodo de pago"
            android:textStyle="bold"
            android:textColor="@color/acento"/>

        <RadioGroup
            android:id="@+id/rgMetodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbEfectivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:textColor="@color/texto"
                android:text="Efectivo"/>

            <RadioButton
                android:id="@+id/rbNequi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/texto"
                android:text="Nequi"/>

            <RadioButton
                android:id="@+id/rbFiado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/texto"
                android:text="Fiado"/>
        </RadioGroup>

        <TextView
            android:id="@+id/tvTotalPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:text="Total: $0"/>

        <Button
            android:id="@+id/btnGenerar"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Generar recibo"/>
    </LinearLayout>
</ScrollView>
