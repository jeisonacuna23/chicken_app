<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etBuscarHistorial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Buscar por cliente..."
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textColor="@color/texto"
            android:textColorHint="@color/textoSuave"/>

        <Button
            android:id="@+id/btnExportarExcel"
            style="@style/BotonPrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Exportar"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistorialVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="No hay ventas registradas."
        android:textColor="@color/textoSuave"
        android:gravity="center"
        android:visibility="gone"/>

    <ListView
        android:id="@+id/lvHistorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
